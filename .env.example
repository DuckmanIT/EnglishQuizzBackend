# Copy to .env and fill in. See docs/DESIGN.md §8.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL — app connection (pooled on Neon) and direct connection (migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/englishquizz
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/englishquizz

# Redis (cache, rate limit, BullMQ)
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible, AWS S3 ap-southeast-1). Needed from phase 2 (uploads, TTS).
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Auth (filled in when the auth module lands)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
GOOGLE_CLIENT_ID=

# AI provider: fake | (provider chosen later)
AI_PROVIDER=fake
AI_API_KEY=
